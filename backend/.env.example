# ScriptSense Backend Environment Configuration Template
# Copy this file to .env and configure as needed:
# cp .env.example .env

# ==============================================================================
# 1. JWT & Security Settings
# ==============================================================================
SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# 2. Database Configuration
# ==============================================================================
# SQLite default:
DATABASE_URL=sqlite:///./scriptsense.db
# PostgreSQL example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/scriptsense

# ==============================================================================
# 3. File Storage Configuration
# ==============================================================================
UPLOAD_DIR=uploads

# ==============================================================================
# 4. AI & Cloud Services
# ==============================================================================
# Google Gemini AI API Key (Used for LLM Evaluation, OCR and Student Marks Explainer)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Vision API Key (Optional fallback OCR)
GOOGLE_VISION_API_KEY=
# Or Service Account Credentials Path:
# GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

# ==============================================================================
# 5. Local OCR & PDF Processing Binaries (Windows / Linux)
# ==============================================================================
# Path to Tesseract OCR executable and tessdata directory
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata

# Path to Poppler Library Bin folder (required for pdf2image)
POPPLER_PATH=./bin/poppler_extracted/poppler-24.08.0/Library/bin

# ==============================================================================
# 6. Server & Network Configuration
# ==============================================================================
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
