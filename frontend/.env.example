# ScriptSense Frontend Environment Template
# Copy this file to .env and configure as needed:
# cp .env.example .env

# Backend API Base URL (FastAPI server address)
VITE_API_BASE_URL=http://localhost:8000

# Application Metadata
VITE_APP_NAME=ScriptSense
VITE_APP_VERSION=1.0.0

# Feature Flags & Debugging (true / false)
VITE_ENABLE_DEBUG=false
